# Provenance of config/detekt.yml. The file is a byte-exact copy of SableOS's; the path excludes in it name
# SableOS modules that are not in this repository and are harmless. Tenseven-specific rules go in
# config/detekt-tenseven.yml once there are any, not in this file.
DETEKT_CONFIG_SOURCE_REPO=aimindseye/zinwaq25-sableos
DETEKT_CONFIG_SOURCE_PATH=sable-src/config/detekt.yml
DETEKT_CONFIG_GIT_BLOB=46ec82af4af1b79a4357bf0a8608538a549b1aaf
DETEKT_GRADLE_PLUGIN_VERSION=1.23.8
KTLINT_GRADLE_PLUGIN_VERSION=14.2.0
KTLINT_ENGINE_VERSION=1.8.0
