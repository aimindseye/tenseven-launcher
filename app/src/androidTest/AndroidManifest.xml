<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name="io.github.aimindseye.tenseven.widgets.P3WidgetProvider" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/p3_widget" />
        </receiver>
        <receiver android:name="io.github.aimindseye.tenseven.widgets.P3ConfiguredWidgetProvider" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/p3_configured_widget" />
        </receiver>
        <activity android:name="io.github.aimindseye.tenseven.widgets.P3WidgetConfigureActivity"
            android:exported="true" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
