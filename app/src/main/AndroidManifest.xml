<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wallpaper-backed Home photo counts (optional; asked for when the user turns that on). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Hub page Contacts tab: names, favourites and one number per person, read on the device and never
         stored. Revocable in Settings; the tab then asks again. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Active Frames recent-apps row. A special-access permission: without this line Android does not list
         Tenseven under Settings, Usage access, and "appops set" is ignored. The user still grants it there. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- All Apps: hand uninstall to the system uninstaller (which confirms again). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Private Space in All Apps: see the private profile. Android grants this to the default Home app only;
         the system asks for the private space credential itself when unlocking. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <!--
      Not requested here, on purpose. The SableOS build of Sable Start holds signature permissions
      (INTERACT_ACROSS_USERS, OBSERVE_GRANT_REVOKE_PERMISSIONS, MODIFY_QUIET_MODE, REAL_GET_TASKS, REORDER_TASKS,
      REMOVE_TASKS, START_TASKS_FROM_RECENTS, READ_FRAME_BUFFER, org.sableos.permission.SPEED_DIAL) because it is
      platform-signed. An ordinary install cannot hold them, Android Lint rejects them, and the code that uses
      them already falls back (Active Frames list only this app's tasks, work-profile privacy rows read
      "unavailable"). Replacements built from public APIs are on the roadmap (docs/ARCHITECTURE.md).
    -->

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Icon packs advertise these actions (Nova and ADW contracts); only used to list packs in Appearance. -->
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="org.adw.ActivityStarter.THEMES" />
        </intent>
        <!-- Optional Sable companions: when installed, their live tiles and Hub data appear on Home. -->
        <provider android:authorities="org.sableos.appearance" />
        <provider android:authorities="org.sableos.weather.snapshot" />
        <provider android:authorities="org.sableos.calendar.snapshot" />
        <provider android:authorities="org.sableos.hub.snapshot" />
        <provider android:authorities="org.sableos.hub.connected_apps" />
        <provider android:authorities="org.sableos.mail.snapshot" />
        <provider android:authorities="org.sableos.media.snapshot" />
        <provider android:authorities="org.sableos.dialer.speeddial" />
        <package android:name="org.sableos.messages" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_tenseven"
        android:roundIcon="@mipmap/ic_tenseven_round"
        android:label="@string/tenseven_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SableLauncher"
        android:usesCleartextTraffic="false">

        <activity
            android:name="io.github.aimindseye.tenseven.SableStartActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">

            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Quick bar and Edit Home entry points. -->
            <intent-filter>
                <action android:name="org.sableos.start.action.EDIT_QUICK_BAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.sableos.start.action.EDIT_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Active Frames: the Recents key on SableOS; reachable from Home on other systems. -->
            <intent-filter>
                <action android:name="org.sableos.start.action.SHOW_ACTIVE_FRAMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- The Hub page (All, Messages, Calls, Contacts), optionally on a tab
                 (extra org.sableos.start.extra.HUB_FILTER). -->
            <intent-filter>
                <action android:name="org.sableos.start.action.SHOW_HUB" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Home screen style (BlackBerry 10 or BlackBerry 7 layout), opened from setup and Start's menu. -->
        <activity
            android:name="io.github.aimindseye.tenseven.HomeStyleActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/home_screen_style">
            <intent-filter>
                <action android:name="org.sableos.start.action.CHOOSE_HOME_STYLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- First-run setup and "Setup and permissions": the home role, then each optional permission. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="@string/setup_menu" />

        <!-- Double-tap to lock. Off until the user enables it in Accessibility settings; it can only lock the screen. -->
        <service
            android:name=".platform.LockScreenAccessibilityService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_accessibility_service" />
        </service>

        <!-- Extra apps ported from SableOS: Calculator (with a unit converter), Notes and ten games. Every one
             ships switched off; Setup turns on the ones the user picks (platform/ExtraAppsControl). No permissions. -->
        <activity
            android:name="io.github.aimindseye.tenseven.extras.calculator.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Calculator"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.notes.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Notes"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Text shared from another app becomes a new note. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.SudokuActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Sudoku"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.MinesweeperActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Minesweeper"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.Game2048Activity"
            android:enabled="false"
            android:exported="true"
            android:label="2048"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.BricksActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Bricks"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.SnakeActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Snake"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.BlocksActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Blocks"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.ReversiActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Reversi"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.SolitaireActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Solitaire"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.MahjongActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Mahjong"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.aimindseye.tenseven.extras.games.WordsActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Words"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Backup and restore of launcher settings through the system file picker. -->
        <activity
            android:name=".BackupActivity"
            android:exported="false"
            android:label="@string/backup_menu" />

        <!-- Notification access, optional and off until the user grants it: groups message and email
             notifications into conversations for the Hub bar. In memory only, nothing is stored or sent. -->
        <service
            android:name=".conversations.ConversationListenerService"
            android:exported="true"
            android:label="@string/tenseven_app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
