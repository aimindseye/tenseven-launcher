    <string name="setup_extras_title">Extra apps (optional)</string>
    <string name="setup_extras_reason">Tenseven can include a calculator with unit conversion, notes, and some classic games. Nothing is installed or downloaded and none is on by default: tick what you want and it appears in All Apps. You can change this any time from Extra apps in Command.</string>
